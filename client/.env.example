# Copy to .env.local for local development.
# Vite bakes these into the JS bundle at build time, so after changing them on
# Vercel you MUST redeploy for the change to take effect.

# --- Option A: long-running server (Render / Railway / Fly / local) ---
# VITE_SERVER_URL=https://pomodoro-server.onrender.com
#
# Leave unset locally to use the default http://localhost:3001.

# --- Option B: server deployed as a Vercel Function (server/api/socket-io.js) ---
# VITE_SERVER_URL=https://pomodoro-server.vercel.app
# VITE_SOCKET_PATH=/api/socket-io/socket.io
# VITE_SOCKET_TRANSPORTS=websocket

# Optional overrides (defaults shown)
# VITE_SOCKET_PATH=/socket.io
